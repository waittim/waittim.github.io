.DS_Store
*.DS_Store

# Jekyll generated output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby/Bundler local state
.bundle/
vendor/bundle/

# Local tooling for image regeneration
.venv-img/

# Large third-party GeoIP database (download from MaxMind; not shipped with the site)
data/geoip/*.mmdb

# Uncompressed CSS. npm run build:assets may write these locally.
# Commit the .min.css files; GitHub Pages serves those.
css/bootstrap.css
css/hux-blog.css
css/theme.css

# Node local state
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
